{
  "name": "locallab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm format:check",
    "typecheck": "pnpm --filter @locallab/mobile --filter @locallab/lan-discovery --filter @locallab/contracts --filter @locallab/schema --filter @locallab/service-contracts --filter @locallab/compat-expo-transport --filter @locallab/compat-gguf-ios --filter @locallab/compat-apple-ml --filter @locallab/compat-mac-host --filter @locallab/testkit --filter @locallab/storage-sqlite-core --filter @locallab/storage-sqlite-extensions --filter @locallab/storage-blobs --filter @locallab/capabilities --filter @locallab/network-http --filter @locallab/provider-ollama-chat --filter @locallab/provider-ollama-models --filter @locallab/provider-lmstudio --filter @locallab/provider-compatible-local --filter @locallab/provider-openai-first-run --filter @locallab/provider-openai-advanced --filter @locallab/provider-anthropic --filter @locallab/provider-gemini --filter @locallab/provider-mistral --filter @locallab/provider-cloud-compatible --filter @locallab/provider-conformance --filter @locallab/models-catalog --filter @locallab/models-imports --filter @locallab/models-fit --filter @locallab/gguf-ios --filter @locallab/mlx-ios --filter @locallab/downloads-ios --filter @locallab/chat-engine-core --filter @locallab/chat-history --filter @locallab/chat-engine-advanced --filter @locallab/archives --filter @locallab/conversation-library --filter @locallab/attachments --filter @locallab/attachments-platform --filter @locallab/search-semantic --filter @locallab/embeddings --filter @locallab/generation-lifecycle-ios --filter @locallab/models-integration --filter @locallab/chat-integration --filter @locallab/parameters --filter @locallab/context --filter @locallab/security-secrets --filter @locallab/jobs --filter @locallab/chat-projection --filter @locallab/personas-library --filter @locallab/memory-extraction --filter @locallab/arena-engine --filter @locallab/tools-engine typecheck",
    "test:contracts": "pnpm --filter @locallab/contracts test",
    "test:schema": "pnpm --filter @locallab/schema test",
    "test:service-contracts": "pnpm --filter @locallab/service-contracts test",
    "test:fixtures": "pnpm test:contracts && pnpm --filter @locallab/testkit test",
    "test:compat": "pnpm --filter @locallab/compat-expo-transport --filter @locallab/compat-gguf-ios --filter @locallab/compat-apple-ml --filter @locallab/compat-mac-host test",
    "test:network": "pnpm --filter @locallab/network-http test",
    "test:connections": "pnpm --filter @locallab/lan-discovery test",
    "test:providers-ollama": "pnpm --filter @locallab/provider-ollama-chat test",
    "test:providers-ollama-models": "pnpm --filter @locallab/provider-ollama-models test",
    "test:providers-lmstudio": "pnpm --filter @locallab/provider-lmstudio test",
    "test:providers-compatible-local": "pnpm --filter @locallab/provider-compatible-local test",
    "test:providers-openai-first": "pnpm --filter @locallab/provider-openai-first-run test",
    "test:providers-cloud": "pnpm --filter @locallab/provider-openai-advanced --filter @locallab/provider-anthropic --filter @locallab/provider-gemini --filter @locallab/provider-mistral test",
    "test:providers-cloud-compatible": "pnpm --filter @locallab/provider-cloud-compatible test",
    "test:providers-conformance": "pnpm --filter @locallab/provider-conformance test",
    "test:models": "pnpm --filter @locallab/models-catalog --filter @locallab/models-imports test",
    "test:models-fit": "pnpm --filter @locallab/models-fit test",
    "test:models-ui": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht apps/mobile/features/models/models.test.mts",
    "test:transcript": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht apps/mobile/features/transcript/core/transcript.test.mts",
    "test:chat-engine-core": "pnpm --filter @locallab/chat-engine-core test",
    "test:gguf-ios": "pnpm --filter @locallab/gguf-ios test",
    "test:mlx-ios": "pnpm --filter @locallab/mlx-ios test",
    "test:downloads-ios": "pnpm --filter @locallab/downloads-ios test",
    "test:storage": "pnpm --filter @locallab/storage-sqlite-core --filter @locallab/storage-sqlite-extensions --filter @locallab/storage-blobs test",
    "test:parameters": "pnpm --filter @locallab/parameters test",
    "test:capabilities": "pnpm --filter @locallab/capabilities test",
    "test:context": "pnpm --filter @locallab/context test",
    "test:security": "pnpm --filter @locallab/security-secrets test",
    "test:jobs": "pnpm --filter @locallab/jobs test",
    "test:projection": "pnpm --filter @locallab/chat-projection test",
    "mobile:start": "pnpm --filter @locallab/mobile start",
    "mobile:web": "pnpm --filter @locallab/mobile web",
    "test:mobile-ui": "playwright test --config tests/ui/playwright.config.ts",
    "mobile:ios": "pnpm --filter @locallab/mobile ios",
    "test:chat-history": "pnpm --filter @locallab/chat-history test",
    "test:composer": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht apps/mobile/features/composer/core/composer.test.mts",
    "test:chat-engine-advanced": "pnpm --filter @locallab/chat-engine-advanced test",
    "test:composer-advanced": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht apps/mobile/features/composer/advanced/composer.test.mts",
    "test:transcript-rich": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht apps/mobile/features/transcript/rich",
    "test:iphone-offline": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht tests/smoke/iphone-offline",
    "test:iphone-openai": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht tests/smoke/iphone-openai",
    "test:archives": "pnpm --filter @locallab/archives test",
    "test:conversation-library": "pnpm --filter @locallab/conversation-library test",
    "test:attachments": "pnpm --filter @locallab/attachments --filter @locallab/attachments-platform test",
    "test:search-semantic": "pnpm --filter @locallab/search-semantic test",
    "test:embeddings": "pnpm --filter @locallab/embeddings test",
    "test:generation-lifecycle-ios": "pnpm --filter @locallab/generation-lifecycle-ios test",
    "test:chat-settings": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht apps/mobile/features/chat-settings/settings.test.mts",
    "test:models-integration": "pnpm --filter @locallab/models-integration test",
    "test:chat-composition": "pnpm --filter @locallab/models-imports exec vitest run --root C:/code/cht apps/mobile/composition",
    "test:chat-integration": "pnpm --filter @locallab/chat-integration test",
    "typecheck:chat-integration": "pnpm --filter @locallab/chat-integration typecheck",
    "test:personas": "pnpm --filter @locallab/personas-library test",
    "test:memory-extraction": "pnpm --filter @locallab/memory-extraction test",
    "test:arena": "pnpm --filter @locallab/arena-engine test",
    "test:tools": "pnpm --filter @locallab/tools-engine test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "tsx@4.16.2": "patches/tsx@4.16.2.patch",
      "@siteed/sherpa-onnx.rn@1.3.2-beta.0": "patches/@siteed__sherpa-onnx.rn@1.3.2-beta.0.patch"
    }
  }
}
