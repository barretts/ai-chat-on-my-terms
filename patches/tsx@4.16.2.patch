+"use strict";
+const path = require("node:path");
+const os = require("node:os");
+const { mkdtempSync } = require("node:fs");
+function temporaryDirectory() {
+  try {
+    const { geteuid } = process;
+    const userId = geteuid ? geteuid() : os.userInfo().username;
+    return path.join(os.tmpdir(), `tsx-${userId}`);
+  } catch (error) {
+    if (
+      process.platform !== "win32" ||
+      error?.code !== "ERR_SYSTEM_ERROR" ||
+      error?.syscall !== "uv_os_get_passwd"
+    ) {
+      throw error;
+    }
+    // Share the private fallback with tsx child processes and loader workers.
+    return process.env.TSX_PRIVATE_TMPDIR ||
+      (process.env.TSX_PRIVATE_TMPDIR = mkdtempSync(path.join(os.tmpdir(), "tsx-private-")));
+  }
+}
+exports.tmpdir = temporaryDirectory();
