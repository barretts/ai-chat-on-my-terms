diff --git a/lib/commonjs/services/TtsService.js b/lib/commonjs/services/TtsService.js
--- a/lib/commonjs/services/TtsService.js
+++ b/lib/commonjs/services/TtsService.js
@@ -132,7 +132,19 @@ class TtsService {
       }
 
       // Call the native API to initialize TTS
-      const result = await this.api.initTts(nativeConfig);
+      // NativeSherpaOnnxSpec.initTts names these fields modelType, voices,
+      // lexicon and vocoder, while TtsModelConfig uses ttsModelType,
+      // voicesFile, lexiconFile and vocoderFile. iOS codegen only forwards
+      // spec-named keys, so without this mapping every engine was built as
+      // VITS and sherpa-onnx called exit(-1) when handed a Kokoro model.
+      const specConfig = {
+        ...nativeConfig,
+        modelType: nativeConfig.ttsModelType
+      };
+      if (nativeConfig.voicesFile) specConfig.voices = nativeConfig.voicesFile;
+      if (nativeConfig.lexiconFile) specConfig.lexicon = nativeConfig.lexiconFile;
+      if (nativeConfig.vocoderFile) specConfig.vocoder = nativeConfig.vocoderFile;
+      const result = await this.api.initTts(specConfig);
 
       // Store initialization results
       this.initialized = result.success;
