{
  "name": "@locallab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck src/index.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@locallab/tools-hosted-search": "workspace:*",
    "@locallab/tools-sandbox": "workspace:*",
    "fastify": "4.28.1"
  },
  "devDependencies": {
    "@types/node": "24.0.10",
    "tsx": "4.16.2",
    "typescript": "5.9.3"
  }
}
