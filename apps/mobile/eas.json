{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "node": "24.13.1",
      "pnpm": "8.15.9",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_STRATA_BASE_URL": "http://192.168.1.213:1234/v1",
        "EXPO_PUBLIC_STRATA_MODEL_ID": "qwen3.8-flash-next-iq3_s-128k",
        "EXPO_PUBLIC_DEV_BENCH": "1"
      },
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "node": "24.13.1",
      "pnpm": "8.15.9",
      "environment": "production",
      "distribution": "store",
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "APP_STORE_BUILD": "1"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "bsonntag@gmail.com",
        "appleTeamId": "KQJWD7GN74",
        "ascAppId": "6824682448",
        "appName": "AI Chat on My Terms",
        "language": "en-US"
      }
    }
  }
}
