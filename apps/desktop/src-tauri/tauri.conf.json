{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Chat on My Terms",
  "version": "0.1.0",
  "identifier": "app.locallab.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-bundle.mjs --dev",
    "beforeBuildCommand": "node scripts/build-bundle.mjs",
    "frontendDist": "../dist/desktop-bundle"
  },
  "app": {
    "windows": [
      {
        "title": "AI Chat on My Terms",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "externalBin": [
      "binaries/locallab-companion",
      "binaries/locallab-gguf-worker",
      "binaries/llama-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
